    {
      "title": "Anywhere in the app",
      "rows": [
        [
          "Ctrl+K",
          "Find anything - a docker, a setting, a button, a style, the guide, a shortcut (the 🔍 in the menu bar too). Over the timeline's layers Ctrl+K still splits, in the image editor it is its own palette"
        ],
        [
          "P",
          "Show / hide the prompt docker (not while typing in a box; over the image editor P is its Pen)"
        ],
        [
          "S",
          "Show / hide Basic Settings - a floating docker (not while typing; over the image editor S is its Clone Stamp)"
        ],
        [
          "L",
          "Show / hide LLM tokens - a floating docker (not while typing; over the image editor L is its Lasso, over the timeline the shuttle)"
        ],
        [
          "1",
          "Show / hide the timeline Tools & Properties window"
        ],
        [
          "2",
          "Show / hide the negative prompt docker (not while typing; while the 🎥 multi-camera dialog is open 1 - 9 cut cameras)"
