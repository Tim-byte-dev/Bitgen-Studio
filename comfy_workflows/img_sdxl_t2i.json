{
  "_comment": "SDXL / Pony / Illustrious text-to-image (2.112.0). Core nodes only: the patcher writes the style's checkpoint (ckpt_name), prompt + negative, seed/steps/cfg/sampler, width/height (EmptyLatentImage), LoRAs (built chain) and clip skip (CLIPSetLastLayer.stop_at_clip_layer = -clip_skip). Pony wants clip skip 2 and the score_ tags; Illustrious clip skip 2 and the quality tags \u2014 the built-in styles set those and the prompt guides teach them.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "stop_at_clip_layer": -2,
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "positive prompt",
      "clip": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "worst quality, low quality, blurry, watermark, text",
      "clip": [
        "2",
        0
      ]
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "1",
        0
      ],
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "latent_image": [
        "5",
        0
      ]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "6",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "h3_sdxl",
      "images": [
        "7",
        0
      ]
    }
  }
}