{
  "bgup_params": {
    "class_type": "MMH3LatentUpscaleWithModelParams",
    "inputs": {"model_name": "minimax_h3_latent_upscaler_3d_bf16.safetensors",
               "width": 1920, "height": 1088, "device": "cuda", "precision": "fp16"},
    "_meta": {"title": "bitGen upscale: 3D latent upscaler (model + target size)"}
  },
  "bgup_temporal": {
    "class_type": "MMH3TemporalSplitParams",
    "inputs": {"chunk_length": 85, "temporal_overlap": 17, "anchor_strength": 0.999},
    "_meta": {"title": "bitGen upscale: temporal chunks"}
  },
  "bgup_spatial": {
    "class_type": "MMH3SpatialSplitParams",
    "inputs": {"upscale_width": 1920, "upscale_height": 1088, "tile_size_mode": "specific_size",
               "tile_width": 1024, "tile_height": 1024, "grid_rows": 9, "grid_cols": 9,
               "spatial_w_overlap": 128, "spatial_h_overlap": 128, "fade_width": 64, "fade_height": 64,
               "min_tile_size": 1024, "overlap_mode": "earlier", "overlap_blend": "linear"},
    "_meta": {"title": "bitGen upscale: spatial tiles"}
  },
  "bgup_noise": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 0},
    "_meta": {"title": "bitGen upscale: noise"}
  },
  "bgup_sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "sa_solver"},
    "_meta": {"title": "bitGen upscale: sampler"}
  },
  "bgup_sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {"scheduler": "beta", "steps": 1, "denoise": 0.2, "model": "@model"},
    "_meta": {"title": "bitGen upscale: one refine step at denoise 0.2"}
  },
  "bgup_upscale": {
    "class_type": "MMH3UltimateUpscale",
    "inputs": {"cfg": 1, "model": "@model", "conditioning": "@conditioning", "latent": "@latent",
               "noise": ["bgup_noise", 0], "sampler": ["bgup_sampler", 0], "sigmas": ["bgup_sigmas", 0],
               "latent_upscale_param": ["bgup_params", 0], "temporal_split_param": ["bgup_temporal", 0],
               "spatial_split_param": ["bgup_spatial", 0]},
    "_meta": {"title": "bitGen upscale: MMH3 Ultimate Upscale"}
  }
}
