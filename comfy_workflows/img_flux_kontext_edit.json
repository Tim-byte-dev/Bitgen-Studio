{
  "_comment": "bitGen Studio 2.332.0 - FLUX.1 Kontext dev instruction EDIT for the image editor (and any image job with one reference picture). Built from ComfyUI's own template flux_kontext_dev_basic (comfyui-workflow-templates 0.11.70): UNETLoader flux1-dev-kontext_fp8_scaled, DualCLIPLoader clip_l + T5-XXL (type flux), VAELoader ae, CLIPTextEncode -> ReferenceLatent (the picture's latent) -> FluxGuidance 2.5; negative = ConditioningZeroOut of the same text; KSampler euler/simple 20 steps cfg 1. Changed from the template: the T5 is t5xxl_fp16 (the SAME file the shipped FLUX Fill inpaint style loads, so one download serves both) and the picture is scaled to ~1 MP with ImageScaleToTotalPixels (keeps the aspect) instead of FluxKontextImageScale. Picture 1 = the LoadImage slot.",
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    },
    "_meta": {
      "title": "Picture 1"
    }
  },
  "2": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 1
    }
  },
  "3": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev-kontext_fp8_scaled.safetensors",
      "weight_dtype": "default"
    }
  },
  "4": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp16.safetensors",
      "type": "flux",
      "device": "default"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "4",
        0
      ],
      "text": "make it night time"
    }
  },
  "7": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "5",
        0
      ]
    }
  },
  "8": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "6",
        0
      ],
      "latent": [
        "7",
        0
      ]
    }
  },
  "9": {
    "class_type": "FluxGuidance",
    "inputs": {
      "conditioning": [
        "8",
        0
      ],
      "guidance": 2.5
    }
  },
  "10": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "6",
        0
      ]
    }
  },
  "11": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "3",
        0
      ],
      "positive": [
        "9",
        0
      ],
      "negative": [
        "10",
        0
      ],
      "latent_image": [
        "7",
        0
      ],
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "11",
        0
      ],
      "vae": [
        "5",
        0
      ]
    }
  },
  "13": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "filename_prefix": "h3_edit"
    }
  }
}