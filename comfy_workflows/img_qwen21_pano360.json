      "images.image_1": [
        "21",
        0
      ]
    },
    "_meta": {
      "title": "Qwen Image 2.1 - the green canvas"
    }
  },
  "11": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
