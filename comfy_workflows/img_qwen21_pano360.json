      "device": "default"
    },
    "_meta": {
      "title": "Qwen3-VL 8B text encoder"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "Qwen Image 2.1 VAE"
    }
  },
  "9": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "Fill the green areas to complete a seamless 360° equirectangular panorama."
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "10": {
