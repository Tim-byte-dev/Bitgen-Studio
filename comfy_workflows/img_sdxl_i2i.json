{
  "_comment": "SDXL / Pony / Illustrious image-to-image (2.112.0). Core nodes only. ONE LoadImage slot: the reference dock's first picture is encoded (VAEEncode) and re-sampled at `denoise` 0.65 \u2014 lower keeps more of the picture, higher changes more; edit the value here or in a copy. The output size follows the reference (no EmptyLatentImage), so Basic Settings' size is ignored for this graph. Everything else as img_sdxl_t2i.json.",
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPSetLastLayer",
    "inputs": {
      "stop_at_clip_layer": -2,
      "clip": [
        "1",
        1
      ]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "positive prompt",
      "clip": [
        "2",
        0
      ]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "worst quality, low quality, blurry, watermark, text",
      "clip": [
        "2",
        0
      ]
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "10",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 1,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.65,
      "model": [
        "1",
        0
      ],
      "positive": [
        "3",
        0
      ],
      "negative": [
        "4",
        0
      ],
      "latent_image": [
        "11",
        0
      ]
    }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "6",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "h3_sdxl_i2i",
      "images": [
        "7",
        0
      ]
    }
  }
}