{
  "1": {"class_type": "LoadImage", "inputs": {"image": "@image"},
        "_meta": {"title": "bitGen tail frame"}},
  "2": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": "@model"},
        "_meta": {"title": "Load Upscale Model"}},
  "3": {"class_type": "ImageUpscaleWithModel", "inputs": {"upscale_model": ["2", 0], "image": ["1", 0]},
        "_meta": {"title": "Upscale Image (using Model)"}},
  "4": {"class_type": "ImageScale", "inputs": {"upscale_method": "lanczos", "width": "@width",
        "height": "@height", "crop": "disabled", "image": ["3", 0]},
        "_meta": {"title": "Scale to the PNG size"}},
  "5": {"class_type": "SaveImage", "inputs": {"filename_prefix": "@prefix", "images": ["4", 0]},
        "_meta": {"title": "Save the tail PNG"}}
}
