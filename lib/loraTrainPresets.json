{
  "_comment": "bitGen Studio — the LoRA trainer's base models (lib/loraTrain.js -> an ai-toolkit config). model = ai-toolkit's model: block (arch / name_or_path / flags); train / sample = what differs from the defaults. vram_gb = what it needs to train (the trainer's own guidance, an estimate). family = the Model manager's type for the finished LoRA. checked = the keys were read from ai-toolkit's own examples / its issue tracker; the others are best knowledge - the YAML stays editable in the docker before a run. 2.521.0: full = a full (checkpoint) fine-tune - no network block, every weight trained, saved in diffusers format and joined into one .safetensors for ComfyUI's diffusion_models; note = what the docker shows under it.",
  "presets": [
    {
      "id": "zimage_turbo",
      "label": "Z-Image Turbo (pictures - the easiest start)",
      "family": "z-image",
      "vram_gb": 16,
      "kind": "image",
      "checked": true,
      "model": {
        "arch": "zimage:turbo",
        "name_or_path": "Tongyi-MAI/Z-Image-Turbo",
        "assistant_lora_path": "ostris/zimage_turbo_training_adapter",
        "quantize": true,
        "qtype": "qfloat8",
        "quantize_te": true,
        "qtype_te": "qfloat8"
      },
      "train": {
        "noise_scheduler": "flowmatch",
        "timestep_type": "sigmoid",
        "lr": 0.0001,
        "steps": 3000
      },
      "sample": {
        "sampler": "flowmatch",
        "guidance_scale": 1,
        "sample_steps": 8
      }
    },
    {
