          "transformer.single_transformer_blocks."
        ]
      },
      "train": {
        "noise_scheduler": "flowmatch",
        "timestep_type": "sigmoid",
        "bypass_guidance_embedding": true,
        "optimizer": "adafactor",
        "lr": 3e-05,
        "steps": 2000,
        "ema_config": {
          "use_ema": true,
          "ema_decay": 0.99
        }
      },
      "sample": {
        "sampler": "flowmatch",
        "guidance_scale": 4,
        "sample_steps": 25
      },
      "note": "ai-toolkit's own full fine-tune example (48 GB). Parameter swapping trains part of the weights each step and needs much less VRAM (a RunPod pod otherwise)."
    },
