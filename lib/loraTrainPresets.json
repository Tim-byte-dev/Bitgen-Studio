    {
      "id": "flex1_ft",
      "full": true,
      "label": "Flex.1-alpha (FLUX-type, Apache 2.0) - full fine-tune (48 GB, less with parameter swapping)",
      "family": "flux",
      "vram_gb": 48,
      "kind": "image",
      "checked": true,
      "model": {
        "name_or_path": "ostris/Flex.1-alpha",
